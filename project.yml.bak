name: HealthLens
options:
  bundleIdPrefix: com.healthlens
  deploymentTarget:
    iOS: "17.0"
  xcodeVersion: "16"
  generateEmptyDirectories: true
  defaultConfig: Debug

settings:
  base:
    SWIFT_VERSION: 5.9
    IPHONEOS_DEPLOYMENT_TARGET: "17.0"
    SWIFT_STRICT_CONCURRENCY: complete
    ENABLE_BITCODE: NO
    MARKETING_VERSION: "1.0.0"
    CURRENT_PROJECT_VERSION: "1"

targets:
  HealthLens:
    type: application
    platform: iOS
    sources:
      - path: HealthLens
        excludes:
          - "**/*.md"
    resources:
      - HealthLens/Resources
    info:
      path: HealthLens/Resources/Info.plist
      properties:
        UIBackgroundModes:
          - fetch
          - processing
        BGTaskSchedulerPermittedIdentifiers:
          - com.healthlens.background-refresh
        NSHealthShareUsageDescription: "HealthLens reads your health data to provide AI-powered insights and personalised recommendations."
        NSHealthUpdateUsageDescription: "HealthLens does not write health data."
        UILaunchScreen:
          UIColorName: ""
          UIImageName: ""
    entitlements:
      path: HealthLens/Resources/HealthLens.entitlements
      properties:
        com.apple.developer.healthkit: true
        com.apple.developer.healthkit.access:
          - health-records
        com.apple.developer.healthkit.background-delivery: true
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.healthlens
        PRODUCT_NAME: HealthLens
        DEVELOPMENT_TEAM: ""
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME: AccentColor
        CODE_SIGN_STYLE: Automatic
    dependencies:
      - sdk: HealthKit.framework
      - sdk: BackgroundTasks.framework

schemes:
  HealthLens:
    build:
      targets:
        HealthLens: all
    run:
      config: Debug
    test:
      config: Debug
    profile:
      config: Release
    analyze:
      config: Debug
    archive:
      config: Release
